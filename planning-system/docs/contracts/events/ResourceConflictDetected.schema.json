{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceConflictDetected",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Устойчивый UUID",
      "examples": [
        "10000000-0000-4000-8000-000000000001"
      ],
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "ResourceConflictDetected",
      "description": "Имя события"
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1,
      "description": "Момент UTC",
      "examples": [
        "2026-10-05T12:00:00Z"
      ],
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "const": "PlanningSystem",
      "description": "Модуль издателя"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Semver"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "description": "Устойчивый UUID",
      "examples": [
        "10000000-0000-4000-8000-000000000001"
      ],
      "format": "uuid"
    },
    "projectId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Проект; null только у внутренних портфельных/ресурсных фактов",
      "examples": [
        null
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "aggregateId": {
          "type": "string",
          "minLength": 1,
          "description": "ID агрегата",
          "examples": [
            "10000000-0000-4000-8000-000000000001"
          ],
          "format": "uuid"
        },
        "aggregateRevision": {
          "type": "integer",
          "minimum": 1,
          "description": "Редакция агрегата",
          "examples": [
            1
          ]
        }
      },
      "required": [
        "aggregateId",
        "aggregateRevision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "producer",
    "schemaVersion",
    "correlationId",
    "projectId",
    "payload"
  ],
  "additionalProperties": false
}
