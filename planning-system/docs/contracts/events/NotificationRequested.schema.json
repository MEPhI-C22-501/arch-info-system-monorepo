{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotificationRequested",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Устойчивый UUID",
      "examples": [
        "10000000-0000-4000-8000-000000000001"
      ],
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "NotificationRequested",
      "description": "Имя события"
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1,
      "description": "Момент UTC",
      "examples": [
        "2026-10-05T12:00:00Z"
      ],
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "const": "PlanningSystem",
      "description": "Модуль издателя"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Semver"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "description": "Устойчивый UUID",
      "examples": [
        "10000000-0000-4000-8000-000000000001"
      ],
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "description": "Ключ партиции и область проекта",
      "examples": [
        "10000000-0000-4000-8000-000000000001"
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "minLength": 1,
          "description": "Устойчивый UUID",
          "examples": [
            "10000000-0000-4000-8000-000000000001"
          ],
          "format": "uuid"
        },
        "causeEventId": {
          "type": "string",
          "minLength": 1,
          "description": "Устойчивый UUID",
          "examples": [
            "10000000-0000-4000-8000-000000000001"
          ],
          "format": "uuid"
        },
        "recipientSubject": {
          "type": "string",
          "minLength": 1,
          "description": "ID адресата",
          "examples": [
            "demo-manager"
          ]
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "description": "Согласованный канал",
          "examples": [
            "in-app"
          ]
        },
        "templateCode": {
          "type": "string",
          "minLength": 1,
          "description": "Код шаблона",
          "examples": [
            "plan-activated"
          ]
        },
        "planVersionId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Устойчивый UUID",
          "examples": [
            null
          ],
          "format": "uuid"
        }
      },
      "required": [
        "notificationId",
        "causeEventId",
        "recipientSubject",
        "channel",
        "templateCode",
        "planVersionId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "producer",
    "schemaVersion",
    "correlationId",
    "projectId",
    "payload"
  ],
  "additionalProperties": false
}
