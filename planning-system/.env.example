# Local synthetic stand; real credentials are supplied outside Git.
PS_DB_PASSWORD=planning-local
PS_CURSOR_SECRET=local-demo-cursor-key-change-for-shared-stand
# Shared stand: AUTH_MODE=oidc, APP_ENV=staging; never enable demo auth there.
# OIDC_ISSUER=https://keycloak.example.invalid/realms/arch
# OIDC_AUDIENCE=planning-api
# OIDC_CLIENT_ID=planning-web
# STORAGE_MODE=s3
# S3_ENDPOINT=https://s3.example.invalid
# S3_BUCKET=arch-dev-planning-system
# AWS_ACCESS_KEY_ID=provided-by-infra
# AWS_SECRET_ACCESS_KEY=provided-by-infra
# TT_BASE_URL=https://task-tracker.example.invalid/api/v1
# TT_MAPPING_APPROVED=false
# TT_TOKEN=provided-via-secret
# HR_MODE=real
# RM_BASE_URL=https://reference-manager.example.invalid/v1
# RM_TOKEN=provided-via-secret
# Or obtain a fresh service token for each hourly refresh:
# RM_TOKEN_URL=https://keycloak.example.invalid/realms/arch/protocol/openid-connect/token
# RM_CLIENT_ID=planning-service
# RM_CLIENT_SECRET=provided-via-secret
# RM_LOCAL_HTTP=true # development localhost only, never shared staging
