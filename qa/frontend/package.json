{
  "name": "qa-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi/v1/openapi.yaml -o src/api/schema.d.ts --default-non-nullable=false"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.2",
    "vite": "8.1.0",
    "vitest": "5.0.2"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
