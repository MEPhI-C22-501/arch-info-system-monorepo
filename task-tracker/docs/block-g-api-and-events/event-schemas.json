{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TaskTrackerDomainEvents.v1",
  "title": "Task Tracker events v1 — local draft",
  "oneOf": [
    {
      "$ref": "#/$defs/WorkItemCreated"
    },
    {
      "$ref": "#/$defs/WorkItemFieldsChanged"
    },
    {
      "$ref": "#/$defs/AssigneeChanged"
    },
    {
      "$ref": "#/$defs/StatusChanged"
    },
    {
      "$ref": "#/$defs/HierarchyChanged"
    },
    {
      "$ref": "#/$defs/CommentChanged"
    },
    {
      "$ref": "#/$defs/TimeLogged"
    },
    {
      "$ref": "#/$defs/AttachmentChanged"
    },
    {
      "$ref": "#/$defs/IterationCompositionChanged"
    },
    {
      "$ref": "#/$defs/IterationActivated"
    },
    {
      "$ref": "#/$defs/IterationCompleted"
    },
    {
      "$ref": "#/$defs/WorkItemHardDeleted"
    },
    {
      "$ref": "#/$defs/BugCreatedFromTesting"
    },
    {
      "$ref": "#/$defs/DirectorySynchronized"
    },
    {
      "$ref": "#/$defs/ExcelImportCompleted"
    },
    {
      "$ref": "#/$defs/NotificationCreated"
    },
    {
      "$ref": "#/$defs/PlanApplied"
    },
    {
      "$ref": "#/$defs/ProjectRetired"
    }
  ],
  "$defs": {
    "BaseEvent": {
      "type": "object",
      "required": [
        "eventId",
        "eventType",
        "aggregateId",
        "occurredAt",
        "correlationId",
        "actor",
        "payload"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "type": "string"
        },
        "aggregateId": {
          "type": "string"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "WorkItemCreated": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "WorkItemCreated"
            },
            "payload": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "statusId": {
                  "type": "string",
                  "format": "uuid"
                },
                "priorityId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "type",
                "title",
                "statusId",
                "priorityId"
              ]
            }
          }
        }
      ]
    },
    "WorkItemFieldsChanged": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "WorkItemFieldsChanged"
            },
            "payload": {
              "type": "object",
              "properties": {
                "changedFields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "oldValues": {
                  "type": "object",
                  "properties": {}
                },
                "newValues": {
                  "type": "object",
                  "properties": {}
                },
                "version": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "changedFields",
                "oldValues",
                "newValues",
                "version"
              ]
            }
          }
        }
      ]
    },
    "AssigneeChanged": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "AssigneeChanged"
            },
            "payload": {
              "type": "object",
              "properties": {
                "oldAssigneeId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "newAssigneeId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "oldAssigneeId",
                "newAssigneeId"
              ]
            }
          }
        }
      ]
    },
    "StatusChanged": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "StatusChanged"
            },
            "payload": {
              "type": "object",
              "properties": {
                "fromStatusId": {
                  "type": "string",
                  "format": "uuid"
                },
                "toStatusId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "fromStatusId",
                "toStatusId"
              ]
            }
          }
        }
      ]
    },
    "HierarchyChanged": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "HierarchyChanged"
            },
            "payload": {
              "type": "object",
              "properties": {
                "oldParentId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "newParentId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                }
              },
              "required": [
                "oldParentId",
                "newParentId"
              ]
            }
          }
        }
      ]
    },
    "CommentChanged": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "CommentChanged"
            },
            "payload": {
              "type": "object",
              "properties": {
                "commentId": {
                  "type": "string",
                  "format": "uuid"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "created",
                    "updated",
                    "deleted"
                  ]
                }
              },
              "required": [
                "commentId",
                "operation"
              ]
            }
          }
        }
      ]
    },
    "TimeLogged": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "TimeLogged"
            },
            "payload": {
              "type": "object",
              "properties": {
                "timeLogId": {
                  "type": "string",
                  "format": "uuid"
                },
                "userId": {
                  "type": "string"
                },
                "hours": {
                  "type": "number",
                  "minimum": 0,
                  "multipleOf": 0.01
                },
                "loggedDate": {
                  "type": "string",
                  "format": "date"
                }
              },
              "required": [
                "timeLogId",
                "userId",
                "hours",
                "loggedDate"
              ]
            }
          }
        }
      ]
    },
    "AttachmentChanged": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "AttachmentChanged"
            },
            "payload": {
              "type": "object",
              "properties": {
                "attachmentId": {
                  "type": "string",
                  "format": "uuid"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "added",
                    "removed"
                  ]
                },
                "fileName": {
                  "type": "string"
                }
              },
              "required": [
                "attachmentId",
                "operation",
                "fileName"
              ]
            }
          }
        }
      ]
    },
    "IterationCompositionChanged": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "IterationCompositionChanged"
            },
            "payload": {
              "type": "object",
              "properties": {
                "iterationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "included",
                    "excluded"
                  ]
                },
                "workItemId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "iterationId",
                "operation",
                "workItemId"
              ]
            }
          }
        }
      ]
    },
    "IterationActivated": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "IterationActivated"
            },
            "payload": {
              "type": "object",
              "properties": {
                "iterationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "baselineVersion": {
                  "type": "string"
                },
                "baseline": {
                  "type": "object",
                  "properties": {}
                }
              },
              "required": [
                "iterationId",
                "baselineVersion",
                "baseline"
              ]
            }
          }
        }
      ]
    },
    "IterationCompleted": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "IterationCompleted"
            },
            "payload": {
              "type": "object",
              "properties": {
                "iterationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "resultVersion": {
                  "type": "string"
                },
                "result": {
                  "type": "object",
                  "properties": {}
                }
              },
              "required": [
                "iterationId",
                "resultVersion",
                "result"
              ]
            }
          }
        }
      ]
    },
    "WorkItemHardDeleted": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "WorkItemHardDeleted"
            },
            "payload": {
              "type": "object",
              "properties": {
                "workItemId": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "workItemId",
                "title",
                "type"
              ]
            }
          }
        }
      ]
    },
    "BugCreatedFromTesting": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "BugCreatedFromTesting"
            },
            "payload": {
              "type": "object",
              "properties": {
                "externalSource": {
                  "type": "string"
                },
                "externalDefectId": {
                  "type": "string"
                },
                "workItemId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "externalSource",
                "externalDefectId",
                "workItemId"
              ]
            }
          }
        }
      ]
    },
    "DirectorySynchronized": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "DirectorySynchronized"
            },
            "payload": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string"
                },
                "users": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "version",
                "users"
              ]
            }
          }
        }
      ]
    },
    "ExcelImportCompleted": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "ExcelImportCompleted"
            },
            "payload": {
              "type": "object",
              "properties": {
                "created": {
                  "type": "integer",
                  "minimum": 0
                },
                "updated": {
                  "type": "integer",
                  "minimum": 0
                },
                "rejected": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "created",
                "updated",
                "rejected"
              ]
            }
          }
        }
      ]
    },
    "NotificationCreated": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "NotificationCreated"
            },
            "payload": {
              "type": "object",
              "properties": {
                "notificationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "recipientId": {
                  "type": "string"
                },
                "changeKind": {
                  "type": "string"
                }
              },
              "required": [
                "notificationId",
                "recipientId",
                "changeKind"
              ]
            }
          }
        }
      ]
    },
    "PlanApplied": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "PlanApplied"
            },
            "payload": {
              "type": "object",
              "properties": {
                "externalProjectId": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "externalProjectId",
                "version"
              ]
            }
          }
        }
      ]
    },
    "ProjectRetired": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEvent"
        },
        {
          "properties": {
            "eventType": {
              "const": "ProjectRetired"
            },
            "payload": {
              "type": "object",
              "properties": {
                "externalProjectId": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "externalProjectId",
                "version"
              ]
            }
          }
        }
      ]
    }
  }
}
