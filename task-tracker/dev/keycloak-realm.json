{
  "realm": "arch-info-system",
  "enabled": true,
  "clients": [
    {
      "clientId": "task-tracker",
      "name": "Task Tracker SPA and audience",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "protocolMappers": [{
        "name": "task-tracker-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": { "included.client.audience": "task-tracker", "access.token.claim": "true", "id.token.claim": "false" }
      }],
      "roles": [{ "name": "testing-service" }, { "name": "reports-service" }]
    },
    { "clientId": "testing-client", "enabled": true, "publicClient": false, "secret": "testing-dev-only", "serviceAccountsEnabled": true, "standardFlowEnabled": false, "fullScopeAllowed": true,
      "protocolMappers": [{ "name": "task-tracker-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.client.audience": "task-tracker", "access.token.claim": "true", "id.token.claim": "false" } }] },
    { "clientId": "reports-client", "enabled": true, "publicClient": false, "secret": "reports-dev-only", "serviceAccountsEnabled": true, "standardFlowEnabled": false, "fullScopeAllowed": true,
      "protocolMappers": [{ "name": "task-tracker-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.client.audience": "task-tracker", "access.token.claim": "true", "id.token.claim": "false" } }] }
  ],
  "users": [
    { "id": "11111111-1111-1111-1111-111111111111", "username": "member", "enabled": true, "credentials": [{ "type": "password", "value": "demo12345", "temporary": false }] },
    { "id": "22222222-2222-2222-2222-222222222222", "username": "lead", "enabled": true, "credentials": [{ "type": "password", "value": "demo12345", "temporary": false }] },
    { "id": "33333333-3333-3333-3333-333333333333", "username": "admin", "enabled": true, "credentials": [{ "type": "password", "value": "demo12345", "temporary": false }] },
    { "username": "service-account-testing-client", "enabled": true, "serviceAccountClientId": "testing-client", "clientRoles": { "task-tracker": ["testing-service"] } },
    { "username": "service-account-reports-client", "enabled": true, "serviceAccountClientId": "reports-client", "clientRoles": { "task-tracker": ["reports-service"] } }
  ]
}
