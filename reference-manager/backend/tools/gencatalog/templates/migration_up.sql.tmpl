-- generated by tools/gencatalog, do not edit by hand
{{- range .Extensions}}
CREATE EXTENSION IF NOT EXISTS {{.}};
{{- end}}

CREATE TABLE {{.Plural}} (
    id BIGINT PRIMARY KEY GENERATED ALWAYS AS IDENTITY,
{{- range .Fields}}{{if .Stored}}
    {{.Name}} {{.SQLColumn}},
{{- end}}{{end}}
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE{{range .ConstraintsSQL}},
    {{.}}{{end}}
);

CREATE TABLE {{.Singular}}_revisions (
    id              BIGINT       PRIMARY KEY GENERATED ALWAYS AS IDENTITY,
    {{.Singular}}_id BIGINT       NOT NULL REFERENCES {{.Plural}}(id) ON DELETE CASCADE,
    revision_number INTEGER      NOT NULL CHECK (revision_number >= 1),
    change          JSONB        NOT NULL,
    changed_by      UUID         NOT NULL,
    changed_at      TIMESTAMPTZ  NOT NULL DEFAULT now(),

    CONSTRAINT uq_{{.Singular}}_revisions_revision
        UNIQUE ({{.Singular}}_id, revision_number)
);
{{range .UniqueNames}}
CREATE UNIQUE INDEX uq_{{$.Plural}}_{{.}}
    ON {{$.Plural}} ({{.}});
{{end}}{{range .RefNames}}
CREATE INDEX idx_{{$.Plural}}_{{.}}
    ON {{$.Plural}} ({{.}});
{{end}}
CREATE INDEX idx_{{.Plural}}_active
    ON {{.Plural}} (id)
    WHERE is_deleted = FALSE;

CREATE INDEX idx_{{.Singular}}_revisions_{{.Singular}}_id
    ON {{.Singular}}_revisions ({{.Singular}}_id);

CREATE INDEX idx_{{.Singular}}_revisions_covering_agg
    ON {{.Singular}}_revisions ({{.Singular}}_id, revision_number DESC)
    INCLUDE (changed_at, changed_by, change);

CREATE INDEX idx_{{.Singular}}_revisions_changed_at
    ON {{.Singular}}_revisions (changed_at);
{{range .Indexes}}
{{.}}
{{end}}
CREATE OR REPLACE VIEW v_expanded_{{.Singular}} AS
SELECT
    t.id,
{{- range .Fields}}
    {{if .Stored}}t.{{.Name}}{{else}}{{.Computed}} AS {{.Name}}{{end}},
{{- end}}
    t.is_deleted,
    agg.revision,
    agg.last_changer,
    agg.created_at,
    agg.updated_at,
    agg.deleted_at
FROM {{.Plural}} t
LEFT JOIN (
    SELECT
        {{.Singular}}_id,
        MAX(revision_number) AS revision,
        MAX(changed_at) AS updated_at,
        (ARRAY_AGG(changed_by ORDER BY revision_number DESC))[1] AS last_changer,
        MIN(changed_at) FILTER (WHERE revision_number = 1) AS created_at,
        MAX(changed_at) FILTER (
            WHERE change @> '[{"path": "/is_deleted", "value": true}]'::jsonb
        ) AS deleted_at
    FROM {{.Singular}}_revisions
    GROUP BY {{.Singular}}_id
) agg ON agg.{{.Singular}}_id = t.id;

COMMENT ON TABLE {{.Plural}} IS
    '{{.Description}} Stores the current state of each record.';

COMMENT ON TABLE {{.Singular}}_revisions IS
    'Immutable audit log of changes applied to {{.Plural}}. Read-only from the application perspective.';

COMMENT ON VIEW v_expanded_{{.Singular}} IS
    'Read-only view that enriches each {{.Singular}} with its latest revision number, '
    'last changer UUID, and lifecycle timestamps derived from the revision log.';
