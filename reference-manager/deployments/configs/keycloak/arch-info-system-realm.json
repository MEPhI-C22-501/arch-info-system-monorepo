{
  "realm": "arch-info-system",
  "displayName": "ERP (local Reference Manager environment)",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "reference-reader", "description": "Reads and exports shared classifiers and HR references (R-01)" },
      { "name": "reference-admin", "description": "Maintains shared classifiers, reads HR references (R-02)" },
      { "name": "reference-hr-admin", "description": "Maintains HR references, salaries and absences (R-04)" },
      { "name": "reference-hr-reader", "description": "Reads all references including salaries and absences (R-05)" }
    ]
  },
  "clients": [
    {
      "clientId": "reference-manager",
      "name": "Reference Manager API",
      "description": "Resource server, the audience of the tokens accepted by the service. It has no login flows.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "reference-manager-ui",
      "name": "Reference Manager administration interface",
      "description": "Public client of the administration interface. Direct access grants are enabled for local development and integration tests only.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8081/*"],
      "webOrigins": ["http://localhost:8081"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8081/*"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "reference-manager-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "reference-manager",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "foreign-app",
      "name": "Application of another module",
      "description": "Its tokens are not issued for the reference-manager audience, the service rejects them.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "username": "admin",
      "email": "admin@reference-manager.local",
      "firstName": "Reference",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
