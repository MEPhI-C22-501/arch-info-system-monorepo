# host ports, chosen so that the stand starts next to the stands of the other modules
REFERENCE_MANAGER_PORT=8083
REFERENCE_MANAGER_UI_PORT=8084
SWAGGER_PORT=8089

POSTGRES_DB=reference_manager
POSTGRES_USER=reference_manager
POSTGRES_PASSWORD=reference_manager
POSTGRES_PORT=5437
# the account of the service with data rights only, created on the first start of the database
POSTGRES_APP_PASSWORD=reference_manager_app

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# secret of the client reference-manager-provisioner, substituted into the realm on the start of Keycloak
KEYCLOAK_PROVISIONER_SECRET=reference-manager-provisioner-secret
# secret of the local service clients of the consumers: reports-client, planning-service, task-tracker-service, qa-service
KEYCLOAK_CONSUMER_SECRET=reference-manager-consumer-secret

OTEL_COLLECTOR_GRPC_PORT=14317
OTEL_COLLECTOR_HTTP_PORT=14318
